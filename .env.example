# ========================================
# DATABASE - MariaDB
# ========================================
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_PASSWORD=YOUR_APP_PASSWORD
API_HTTP_PORT=5000
FRONTEND_HTTP_PORT=3000

# ========================================
# AUTHENTICATION - JWT
# ========================================
Jwt__Key=YOUR_SECURE_JWT_KEY_MIN_32_CHARS

# ========================================
# PUBLIC URLS
# ========================================
App__BaseUrl=http://localhost:5000
Cors__AllowedOrigins__0=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000/api

# ========================================
# EMAIL
# ========================================
Email__FromEmail=noreply@fullstackfoundation.example
Email__Username=noreply@fullstackfoundation.example
Email__Password=YOUR_EMAIL_APP_PASSWORD
